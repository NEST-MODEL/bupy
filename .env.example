# Firebase Web App config (Firebase Console → Project settings → Your apps → Web).
# Это публичная клиентская конфигурация, а не секрет: доступ защищают Security Rules.
# Service account / private key сюда НЕ добавлять никогда.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Необязательно (не нужны для Auth + Firestore):
VITE_FIREBASE_MESSAGING_SENDER_ID=
